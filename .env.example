# Copier en .env et remplir. Ne jamais versionner ni partager .env.
FPH_ENV=prod
FPH_SECRET_KEY=                 # obligatoire : python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=              # obligatoire

# Compte super administrateur créé UNE fois, si la base est vide.
FPH_BOOTSTRAP_ADMIN_USERNAME=Admin
FPH_BOOTSTRAP_ADMIN_PASSWORD=   # saisir ici ; changement OBLIGATOIRE à la première connexion

FPH_ACCESS_TTL_MINUTES=30
FPH_MAX_UPLOAD_MB=20
FPH_SERVER_NAME=FPH Connect     # nom annoncé sur le réseau local
FPH_API_PORT=8000

# Chiffrement (TLS) — OBLIGATOIRE en production : le serveur refuse de démarrer sinon
FPH_TLS_CERT=/certs/server.pem
FPH_TLS_KEY=/certs/server.key
FPH_API_SCHEME=https            # annoncé par la découverte réseau
# FPH_BEHIND_TLS_PROXY=1        # SEULEMENT si un proxy TLS est placé devant et que le serveur écoute en local

# Impression réseau
FPH_MAX_PRINT_MB=20             # taille maximale d'un document à imprimer
FPH_PRINT_EXPIRY_HOURS=24       # un travail en attente plus longtemps passe en erreur
FPH_PRINT_LEASE_SECONDS=300     # délai accordé à un agent pour confirmer l'envoi avant reprise
FPH_PRINT_MAX_ATTEMPTS=3
FPH_PRINT_MAX_ACTIVE=20         # travaux simultanés par utilisateur
